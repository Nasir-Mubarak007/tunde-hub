# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Neon Postgres). The app uses the pooled URL, migrations use the direct one.
DATABASE_URL=
DIRECT_DATABASE_URL=

# Auth (Better Auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Owner seed script, read once and never at runtime
OWNER_EMAIL=
OWNER_PASSWORD=

# Uploads (UploadThing)
UPLOADTHING_TOKEN=

# Error reporting (Sentry)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# The release the build uploads its source maps against. Defaults to VERCEL_GIT_COMMIT_SHA.
SENTRY_RELEASE=
# The environment name events are filed under. Defaults to VERCEL_ENV.
SENTRY_ENVIRONMENT=
# Share of performance transactions kept. Defaults to 1, so the slow request threshold does the filtering.
SENTRY_TRACES_SAMPLE_RATE=1
# Set to true to report from preview deployments, which then need their own DSN.
SENTRY_SEND_IN_PREVIEW=
SENTRY_PREVIEW_DSN=
# The browser can only read a public name, so it gets its own pair of values.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_SEND_IN_PREVIEW=
NEXT_PUBLIC_SENTRY_PREVIEW_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# Rate limiting
HASH_SECRET=

# The seller WhatsApp number for the claim handoff. Digits with a country code and no plus.
SELLER_WHATSAPP_NUMBER=

# Daily cleanup job
CRON_SECRET=
