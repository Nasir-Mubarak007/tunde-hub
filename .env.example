# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Neon Postgres). The app uses the pooled URL, migrations use the direct one.
DATABASE_URL=
DIRECT_DATABASE_URL=

# Auth (Better Auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Owner seed script, read once and never at runtime
OWNER_EMAIL=
OWNER_PASSWORD=

# Uploads (UploadThing)
UPLOADTHING_TOKEN=

# Error reporting (Sentry)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Rate limiting
HASH_SECRET=

# The seller WhatsApp number for the claim handoff. Digits with a country code and no plus.
SELLER_WHATSAPP_NUMBER=

# Daily cleanup job
CRON_SECRET=
